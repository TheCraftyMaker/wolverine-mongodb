<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 test projects are executables (the package's targets hard-error otherwise). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="All" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Testcontainers.MongoDb" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Compliance harness: the submodule project-ref gives a single consistent Wolverine.dll and is
       what CI builds (UseWolverineSource=true). WolverineFx.ComplianceTests is also published on NuGet,
       so the PackageReference path works for a checkout without the submodule. -->
  <ItemGroup Condition="'$(UseWolverineSource)' == 'true'">
    <ProjectReference Include="$(WolverineSourcePath)\src\Testing\Wolverine.ComplianceTests\Wolverine.ComplianceTests.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseWolverineSource)' != 'true'">
    <PackageReference Include="WolverineFx.ComplianceTests" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wolverine.MongoDB\Wolverine.MongoDB.csproj" />
  </ItemGroup>
</Project>
