<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the external/wolverine submodule pin (tag V<version>) in sync with these. -->
    <PackageVersion Include="WolverineFx" Version="6.65.1" />
    <PackageVersion Include="WolverineFx.ComplianceTests" Version="6.65.1" />
    <PackageVersion Include="WolverineFx.Http" Version="6.65.1" />
    <PackageVersion Include="MongoDB.Driver" Version="3.14.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.17.0" />
    <!-- xUnit v3 4.x runs on Microsoft.Testing.Platform 2.x. WolverineFx.ComplianceTests is built on
         xunit.v3.extensibility.core 4.0.2, and a 3.x test host beside it fails at run time, so the two move
         together. Same pin as upstream Wolverine. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- The leadership-election compliance specs are Bobcat specifications: Bobcat.Xunit supplies the
         test-platform session hook and Bobcat.Generators binds each inherited spec to the subclass. -->
    <PackageVersion Include="Bobcat.Xunit" Version="1.0.0" />
    <PackageVersion Include="Bobcat.Generators" Version="1.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- 2.4.1 is a VSTest logger: Microsoft.Testing.Platform does not load it, so it only applies when the test
         project runs under VSTest. Same pin as upstream Wolverine; 3.x does not compile next to MTP 2.x. -->
    <PackageVersion Include="GitHubActionsTestLogger" Version="2.4.1" />
  </ItemGroup>
</Project>
